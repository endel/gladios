#!/usr/bin/env python3
"""
Turns the check on while the backend is overloaded, and off once it has been calm a while, so
visitors (and search engines) only meet it during a flood. Run it as a service
(systemd/gladios-auto.service) and hand it the switch with `gladios-gate auto`; `gladios-gate
on|off` pins the check, and gladios-auto leaves it alone until `auto` again.

/etc/gladios/auto.conf says what overloaded means, with either or both of:

  fpm_status = http://127.0.0.1/fpm-status?json   ; a php-fpm pool's status page, as JSON:
  fpm_max    = 6                                  ; overloaded with no idle worker and fpm_max busy
  probe      = /usr/local/bin/overloaded          ; any command: overloaded while it exits 0

and, optionally, when to act (the defaults):

  on_after   = 10     ; seconds overloaded before the check comes on
  min_on     = 900    ; seconds it stays on at the least
  quiet      = 900    ; then off once calm this long: not overloaded, and fewer than
  quiet_rate = 300    ; check pages a minute than this (nginx logs each to gladios.log)
  poll       = 2      ; seconds between looks

Each switch is printed (the service's journal) and posted to notify.conf's webhook, if there is one.
Python 3.8+ and its standard library only, like gladios-notify.
"""

import json
import os
import re
import socket
import subprocess
import time
import urllib.request
from collections import deque

CONF = os.environ.get('GLADIOS_AUTO_CONF', '/etc/gladios/auto.conf')
SWITCH = os.environ.get('GLADIOS_SWITCH', '/etc/gladios/switch.conf')
NOTIFY = '/etc/gladios/notify.conf'
GATE = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'gladios-gate')
DEFAULTS = {'on_after': 10, 'min_on': 900, 'quiet': 900, 'quiet_rate': 300, 'poll': 2,
            'pages_log': '/var/log/nginx/gladios.log'}


def log(msg):
    print(msg, flush=True)


def read_conf(path):
    """key = value lines, quotes and ;/# comments as in an ini file (gladios-notify's format)."""
    conf = {}
    with open(path, encoding='utf-8') as f:
        for line in f:
            m = re.match(r'\s*([A-Za-z_]+)\s*=\s*(.*?)\s*$', line)
            if not m:
                continue
            value = m.group(2)
            if value[:1] in ('"', "'"):
                end = value.find(value[0], 1)
                value = value[1:end] if end > 0 else value[1:]
            else:
                value = re.split(r'\s[;#]', value, maxsplit=1)[0].strip()
            conf[m.group(1)] = value
    return conf


def settings():
    """auto.conf over the defaults, or None while it's missing or names nothing to watch."""
    try:
        conf = {**DEFAULTS, **read_conf(CONF)}
    except FileNotFoundError:
        return None
    if not conf.get('probe') and not (conf.get('fpm_status') and conf.get('fpm_max')):
        return None
    for key in ('on_after', 'min_on', 'quiet', 'poll'):
        conf[key] = float(conf[key])
    conf['quiet_rate'] = int(conf['quiet_rate'])
    if conf.get('fpm_max'):
        conf['fpm_max'] = int(conf['fpm_max'])
    return conf


def span(seconds):
    return f'{seconds:.0f}s' if seconds < 120 else f'{seconds / 60:.0f} min'


def overloaded(conf):
    """Why the backend is overloaded right now, or None. A php-fpm status page that doesn't answer
    (a restart) counts as not overloaded."""
    if conf.get('fpm_status'):
        try:
            with urllib.request.urlopen(conf['fpm_status'], timeout=2) as r:
                status = json.load(r)
            if status['idle processes'] == 0 and status['active processes'] >= conf['fpm_max']:
                return f"php-fpm's {status.get('pool', 'pool')} has no idle worker ({status['active processes']} busy)"
        except Exception:
            pass
    if conf.get('probe'):
        try:
            if subprocess.run(conf['probe'], shell=True, timeout=10, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0:
                return f'`{conf["probe"]}` reports overload'
        except subprocess.TimeoutExpired:
            pass
    return None


def switch():
    """(mode, on) from switch.conf, as gladios-gate wrote it."""
    with open(SWITCH, encoding='utf-8') as f:
        text = f.read()
    m = re.search(r'^# mode: (\S+)', text, re.M)
    return (m.group(1) if m else 'on'), re.search(r'^map .*default\s+1;', text, re.M) is not None


class Pages:
    """Check pages served since the last call: lines appended to nginx's gladios.log, across
    rotations."""

    def __init__(self, path):
        self.path = path
        self.inode, self.offset = self.stat()

    def stat(self):
        try:
            st = os.stat(self.path)
            return st.st_ino, st.st_size
        except FileNotFoundError:
            return None, 0

    def new(self):
        inode, size = self.stat()
        if inode != self.inode or size < self.offset:
            self.inode, self.offset = inode, 0
        if inode is None or size == self.offset:
            return 0
        with open(self.path, 'rb') as f:
            f.seek(self.offset)
            data = f.read(size - self.offset)
        self.offset += len(data)
        return data.count(b'\n')


def notify(text):
    try:
        conf = read_conf(NOTIFY)
    except FileNotFoundError:
        return
    if not conf.get('webhook'):
        return
    body = {'discord': {'content': text, 'allowed_mentions': {'parse': []}},
            'json': {'event': 'gladios-auto', 'text': text}}.get(conf.get('format', 'slack'), {'text': text})
    req = urllib.request.Request(conf['webhook'], data=json.dumps(body).encode(),
                                 headers={'Content-Type': 'application/json'})
    try:
        urllib.request.urlopen(req, timeout=10).close()
    except Exception as e:
        log(f'webhook failed: {e}')


def gate(state):
    r = subprocess.run([GATE, 'set', state], capture_output=True, text=True)
    if r.returncode != 0:
        log(f'gladios-gate set {state} failed: {r.stderr.strip()}')
    return r.returncode == 0


def main():
    host = socket.gethostname()
    conf, conf_mtime, pages = None, -1, None
    window = deque()  # (time, check pages) over the last minute
    over_since = on_since = calm_since = None

    while True:
        try:
            mtime = os.stat(CONF).st_mtime
        except FileNotFoundError:
            mtime = None
        if mtime != conf_mtime:
            conf_mtime, conf = mtime, settings()
            if conf:
                pages = Pages(conf['pages_log'])
                watched = ' and '.join(x for x in (conf.get('fpm_status'), conf.get('probe')) if x)
                log(f"watching {watched}: on after {span(conf['on_after'])} overloaded, off after "
                    f"{span(conf['min_on'])} on and {span(conf['quiet'])} calm (under {conf['quiet_rate']} check pages a minute)")
            else:
                log(f'nothing to watch: {CONF} needs fpm_status and fpm_max, or probe')
        time.sleep(conf['poll'] if conf else 30)
        if not conf:
            continue

        now = time.monotonic()
        window.append((now, pages.new()))
        while window[0][0] < now - 60:
            window.popleft()
        per_min = sum(n for _, n in window)
        reason = overloaded(conf)
        over_since = (over_since or now) if reason else None
        mode, on = switch()

        if mode != 'auto':
            on_since = calm_since = now if on else None
            continue
        if not on:
            on_since = None
            if over_since is not None and now - over_since >= conf['on_after'] and gate('on'):
                on_since = calm_since = now
                msg = f'gladios on {host}: the check is ON, {reason} for {span(now - over_since)}. `gladios-gate off` pins it off.'
                log(msg)
                notify(msg)
            continue
        on_since = on_since or now
        if reason or per_min >= conf['quiet_rate']:
            calm_since = now
        calm_since = calm_since or now
        if now - on_since >= conf['min_on'] and now - calm_since >= conf['quiet'] and gate('off'):
            msg = (f"gladios on {host}: the check is OFF after {span(now - on_since)}, calm for "
                   f"{span(conf['quiet'])} with under {conf['quiet_rate']} check pages a minute.")
            log(msg)
            notify(msg)
            on_since = calm_since = None


if __name__ == '__main__':
    main()
